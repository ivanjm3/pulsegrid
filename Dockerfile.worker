# Multi-stage build for the Pulsegrid worker pod. Runtime image needs ffmpeg
# on PATH (pkg/worker.NewTranscoder shells out to "ffmpeg").
FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /out/pulsegrid-worker ./cmd/worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates ffmpeg
COPY --from=build /out/pulsegrid-worker /usr/local/bin/pulsegrid-worker

EXPOSE 8081
USER nobody
ENTRYPOINT ["pulsegrid-worker"]
