# Multi-stage build for the analytics consumer. No ffmpeg needed — same
# reasoning as Dockerfile.api: this binary only talks to Kafka and Postgres,
# never transcodes video.
FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /out/pulsegrid-analytics-consumer ./cmd/analytics-consumer

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/pulsegrid-analytics-consumer /usr/local/bin/pulsegrid-analytics-consumer

EXPOSE 8082
USER nobody
ENTRYPOINT ["pulsegrid-analytics-consumer"]
